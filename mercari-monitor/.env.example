# ==============================================================================
# Mercari US Monitor — configuration
# Copy this file to .env and fill in the values you need.
# Never commit your real .env (it may contain your Discord webhook URL).
# ==============================================================================

# --- Application server -------------------------------------------------------
# Bound to localhost by default. Do not expose this dashboard on the internet.
APP_HOST=127.0.0.1
APP_PORT=8000
# development | production | test
APP_ENV=production

# --- Database ------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/mercari.db

# --- Scanning --------------------------------------------------------------
# Default interval (seconds) applied to newly created searches.
DEFAULT_SCAN_INTERVAL=5
# Hard floor enforced regardless of what a search requests, to keep total load
# reasonable no matter how many keywords are configured.
MIN_SCAN_INTERVAL=3

# --- Rate limiting (global, shared across every keyword) -----------------------
MAX_CONCURRENT_REQUESTS=3
# Minimum delay between the *starts* of two consecutive Mercari fetches,
# regardless of how many keywords are active.
MIN_REQUEST_INTERVAL_MS=800

# --- HTTP / browser client ------------------------------------------------------
REQUEST_TIMEOUT=10
NAVIGATION_TIMEOUT_MS=15000
# Mercari's search results require a real browser session (see README ->
# Architecture). Keep this true; false is only useful for local debugging
# with a visible window, it does not change what is or isn't fetched.
BROWSER_HEADLESS=true
# Advanced/optional: point at a specific Chromium binary instead of the one
# `playwright install chromium` downloads. Leave empty unless you know you
# need it (e.g. a container image with its own Chromium).
PLAYWRIGHT_EXECUTABLE_PATH=

# --- Retry / backoff -------------------------------------------------------
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=250
RETRY_MAX_DELAY_MS=8000

# --- Discord ---------------------------------------------------------------
# Leave empty to disable Discord notifications globally.
DISCORD_WEBHOOK_URL=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- Timezone ------------------------------------------------------------------
# Storage is always UTC. This only controls how times are displayed.
DISPLAY_TIMEZONE=UTC

# --- Retention -----------------------------------------------------------------
ARCHIVE_AFTER_DAYS=90

# --- First run -------------------------------------------------------------
# import_silent: existing results found on the very first scan are stored
#                but do not trigger Discord/notifications ("catch-up" import).
# treat_as_new:  every result found on the first scan fires a normal alert.
FIRST_RUN_MODE=import_silent
